# Copy this file to .env and fill in values. Never commit .env.
# Full explanation of every variable: docs/book/ENV.md

# Public address of this app on THIS machine/server (set differently per environment)
APP_URL=
# Optional: only if the API lives on a different server. Leave empty for same-server. (baked in at build time)
NEXT_PUBLIC_API_BASE_URL=
# Comma-separated sites allowed to call the API
ALLOWED_ORIGINS=

# MongoDB Atlas connection string
MONGODB_URI=

# Cloudinary (media hosting)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Office login (phase P02). Step by step: docs/OFFICE-SETUP.md
# 32 random bytes in base64 (salts stored IP hashes). Required in production.
SESSION_SECRET=
# Secret address of the Office: 8-64 chars, a-z 0-9 hyphen. Empty = Office switched off.
ADMIN_ROUTE_SLUG=
# Made with: node scripts/hash-password.mjs  (looks like b64:...)
ADMIN_BOOTSTRAP_HASH=
COOKIE_DOMAIN=

# AI Twin (phase P07)
GEMINI_API_KEY=
# Optional: which Gemini model to use (default: gemini-flash-latest)
GEMINI_MODEL=
# Optional: only for proxies or tests. Leave empty to talk to Google directly.
GEMINI_API_BASE_URL=

# Encrypts your 2FA secret now (P02) and service credentials later (P08). 32 random bytes in base64. Back it up.
SERVICE_CRED_KEY=
# Optional: set to true ONLY if you self-host and want to monitor addresses on your own private network
ALLOW_PRIVATE_SERVICE_TARGETS=
# Optional: only for proxies or tests. Leave empty to talk to Render directly.
RENDER_API_BASE_URL=
